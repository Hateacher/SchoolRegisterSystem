             padding-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th { background: #c0392b; color: white; padding: 12px; text-align: left; }
        td { padding: 10px; border-bottom: 1px solid #ddd; }
        tr:hover { background: #fff3f3; }
        .info { background: #ffeaea; padding: 15px; border-radius: 5px; 
                margin: 15px 0; border-left: 4px solid #c0392b; }
        .error { background: #fce4e4; padding: 15px; border-radius: 5px; 
                 margin: 15px 0; border-left: 4px solid #e74c3c; color: #c0392b; }
        .success { background: #eafaf1; padding: 15px; border-radius: 5px; 
                   margin: 15px 0; border-left: 4px solid #27ae60; color: #1e8449; }
    </style>
</head>
<body>
<div class="container">
    <h2>🏫 第3组 - J2EE连接人大金仓数据库实验</h2>
    
    <div class="info">
        <strong>📋 实验信息</strong><br>
        分组编号：第<strong>3</strong>组<br>
        数据库类型：人大金仓 KingbaseES<br>
        表名：<strong>student</strong><br>
        字段：id (varchar) | info (varchar) | class (varchar)
    </div>

<%
    // ============ 加载数据库配置 ============
    Properties props = new Properties();
    String configPath = "/WEB-INF/classes/dbconfig.properties";
    try {
        InputStream input = application.getResourceAsStream(configPath);
        if (input != null) {
            props.load(input);
            input.close();
        }
    } catch (Exception e) {
        out.println("<div class='error'>⚠ 配置文件读取失败: " + e.getMessage() + "</div>");
        return;
    }

    String driver   = props.getProperty("db.driver",   "com.kingbase8.Driver");
    String url      = props.getProperty("db.url",      "jdbc:kingbase8://127.0.0.1:54321/test");
    String username = props.getProperty("db.username", "system");
    String password = props.getProperty("db.password", "123456");

    Connection conn = null;
    Statement  stmt = null;
    ResultSet  rs   = null;

    try {
        // ============ 加载驱动并连接 ============
        Class.forName(driver);
        conn = DriverManager.getConnection(url, username, password);
        
        out.println("<div class='success'>✅ 数据库连接成功！URL: " + url + "</div>");

        // ============ 查询 student 表 ============
        stmt = conn.createStatement();
        String sql = "SELECT id, info, class FROM student ORDER BY id";
        rs = stmt.executeQuery(sql);

        out.println("<table>");
        out.println("<tr><th>序号</th><th>ID（分组号）</th><th>INFO（信息内容）</th><th>CLASS（班级）</th></tr>");
        
        int rowNum = 0;
        while (rs.next()) {
            rowNum++;
            out.println("<tr>");
            out.println("<td>" + rowNum + "</td>");
            out.println("<td>" + rs.getString("id") + "</td>");
            out.println("<td>" + rs.getString("info") + "</td>");
            out.println("<td>" + rs.getString("class") + "</td>");
            out.println("</tr>");
        }
        out.println("</table>");

        if (rowNum == 0) {
            out.println("<div class='info'>📭 当前 student 表无数据（实验时请先插入数据）</div>");
        } else {
            out.println("<div class='success'>📊 共查询到 <strong>" + rowNum + "</strong> 条记录</div>");
        }

    } catch (ClassNotFoundException e) {
        out.println("<div class='error'>❌ 驱动未加载: " + e.getMessage() + 
                    "<br>请将 kingbase8-*.jar 放入 WEB-INF/lib/ 目录</div>");
    } catch (SQLException e) {
        out.println("<div class='error'>❌ 数据库连接失败: " + e.getMessage() + 
                    "<br>请在 dbconfig.properties 中检查连接参数</div>");
    } catch (Exception e) {
        out.println("<div class='error'>❌ 未知错误: " + e.getMessage() + "</div>");
    } finally {
        // ============ 释放资源 ============
        try { if (rs   != null) rs.close();   } catch (Exception e) {}
        try { if (stmt != null) stmt.close(); } catch (Exception e) {}
        try { if (conn != null) conn.close(); } catch (Exception e) {}
    }
%>

    <div class="info" style="margin-top:20px;">
        <strong>💡 实验时操作提示：</strong><br>
        1. 修改 <code>WEB-INF/classes/dbconfig.properties</code> 中的数据库连接信息<br>
        2. 确保 <code>WEB-INF/lib/kingbase8-*.jar</code> 驱动存在<br>
        3. 访问地址：<code>http://服务器IP:8080/KingbaseDemo/index.jsp</code>
    </div>
</div>
</body>
</html>
